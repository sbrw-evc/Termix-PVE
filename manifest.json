{
  "id": "pve",
  "name": "Proxmox VE",
  "version": "0.1.3",
  "description": "Manage Proxmox VE from Termix: virtual machines, containers, storage, network, backups, firewall, access and the cluster.",
  "author": {
    "name": "Дмитрий Ляхов"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/sbrw-evc/Termix-PVE",
  "docs": "https://github.com/sbrw-evc/Termix-PVE/blob/main/docs/index.md",
  "category": "Infrastructure",
  "icon": "Server",
  "features": [
    "A Proxmox tool in the sidebar once a host is marked as a Proxmox node",
    "Start, stop, shut down, reboot, suspend and resume VMs and containers",
    "Create, clone, migrate, convert to template and delete VMs and containers",
    "CPU, memory, network and disk charts for nodes and guests",
    "Connect through the Proxmox API over SSH, straight to the API, or with pvesh over SSH"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "network:serve",
    "network:outbound",
    "ui:surface"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "pve",
        "titleKey": "nav.title",
        "icon": "Server",
        "openFrom": ["rail", "palette", "host-context-menu"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "operate",
        "titleKey": "permissions.operate.title",
        "descriptionKey": "permissions.operate.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "configure",
        "titleKey": "permissions.configure.title",
        "descriptionKey": "permissions.configure.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "administer",
        "titleKey": "permissions.administer.title",
        "descriptionKey": "permissions.administer.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enablePve",
        "enableLabelKey": "settings.enable.label",
        "enableDescriptionKey": "settings.enable.description",
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "pveTransport",
            "type": "select",
            "labelKey": "settings.transport.label",
            "descriptionKey": "settings.transport.description",
            "default": "auto",
            "defaultable": false,
            "options": [
              {
                "value": "auto",
                "labelKey": "settings.transport.auto"
              },
              {
                "value": "tunnel",
                "labelKey": "settings.transport.tunnel"
              },
              {
                "value": "direct",
                "labelKey": "settings.transport.direct"
              },
              {
                "value": "pvesh",
                "labelKey": "settings.transport.pvesh"
              }
            ]
          },
          {
            "key": "pveTokenId",
            "type": "string",
            "labelKey": "settings.tokenId.label",
            "descriptionKey": "settings.tokenId.description",
            "placeholderKey": "settings.tokenId.placeholder",
            "defaultable": false,
            "ownerOnly": true
          },
          {
            "key": "pveTokenSecret",
            "type": "secret",
            "labelKey": "settings.tokenSecret.label",
            "descriptionKey": "settings.tokenSecret.description",
            "defaultable": false,
            "ownerOnly": true
          },
          {
            "key": "pveApiHost",
            "type": "string",
            "labelKey": "settings.apiHost.label",
            "descriptionKey": "settings.apiHost.description",
            "defaultable": false
          },
          {
            "key": "pveApiPort",
            "type": "number",
            "labelKey": "settings.apiPort.label",
            "descriptionKey": "settings.apiPort.description",
            "default": 8006,
            "min": 1,
            "max": 65535,
            "defaultable": false
          },
          {
            "key": "pveCaCert",
            "type": "textarea",
            "labelKey": "settings.caCert.label",
            "descriptionKey": "settings.caCert.description",
            "placeholderKey": "settings.caCert.placeholder",
            "defaultable": false
          }
        ]
      }
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
