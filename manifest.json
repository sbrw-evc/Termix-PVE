{
  "id": "pve",
  "name": "Proxmox VE",
  "version": "0.4.6",
  "description": "Manage Proxmox VE from Termix: virtual machines, containers, storage, network, backups, firewall, access and the cluster.",
  "author": {
    "name": "Дмитрий Ляхов"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/sbrw-evc/Termix-PVE",
  "docs": "https://github.com/sbrw-evc/Termix-PVE/blob/main/docs/index.md",
  "category": "Infrastructure",
  "icon": "Server",
  "features": [
    "A Proxmox tool in the sidebar once a host is marked as a Proxmox node",
    "Start, stop, shut down, reboot, suspend and resume VMs and containers",
    "Create, clone, migrate, convert to template and delete VMs and containers",
    "Edit processors, memory, disks, network adapters, options and cloud-init",
    "Download ISO images and CT templates, and delete storage content",
    "Open a VM console (noVNC) or a container shell (xterm.js) in Termix",
    "Upload ISO images and CT templates from the browser",
    "Create, edit and apply node network bridges, bonds and VLANs",
    "Import VMs and containers as Termix hosts and keep them in sync",
    "Node services, updates, disks with SMART, log, reboot and shutdown",
    "CPU, load, memory, swap, network, disk and pressure stall charts for nodes and guests",
    "Snapshots, backups with restore, backup jobs and Proxmox Backup Server storage",
    "Replication jobs and high availability: resources, rules and migration",
    "Firewall for the datacenter, nodes and guests: rules, security groups, aliases and IP sets",
    "Users, API tokens, two factor, groups, pools, roles, realms and permissions",
    "Cluster summary with join information, and Ceph health per node",
    "Connect through the Proxmox API over SSH, straight to the API, or with pvesh over SSH"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.4"
  },
  "capabilities": [
    "hosts:read",
    "hosts:write",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "network:serve",
    "network:outbound",
    "ui:surface",
    "users:impersonate"
  ],
  "contributes": {
    "tabs": [
      {
        "id": "pve",
        "titleKey": "nav.title",
        "icon": "Server",
        "openFrom": ["rail", "palette", "host-context-menu"]
      },
      {
        "id": "pve-console",
        "titleKey": "console.tabTitle",
        "icon": "SquareTerminal",
        "openFrom": ["palette"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "operate",
        "titleKey": "permissions.operate.title",
        "descriptionKey": "permissions.operate.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "console",
        "titleKey": "permissions.console.title",
        "descriptionKey": "permissions.console.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "configure",
        "titleKey": "permissions.configure.title",
        "descriptionKey": "permissions.configure.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "administer",
        "titleKey": "permissions.administer.title",
        "descriptionKey": "permissions.administer.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enablePve",
        "enableLabelKey": "settings.enable.label",
        "enableDescriptionKey": "settings.enable.description",
        "editorGroup": "ssh",
        "fields": [
          {
            "key": "pveTransport",
            "type": "select",
            "labelKey": "settings.transport.label",
            "descriptionKey": "settings.transport.description",
            "default": "auto",
            "defaultable": false,
            "options": [
              {
                "value": "auto",
                "labelKey": "settings.transport.auto"
              },
              {
                "value": "tunnel",
                "labelKey": "settings.transport.tunnel"
              },
              {
                "value": "direct",
                "labelKey": "settings.transport.direct"
              },
              {
                "value": "pvesh",
                "labelKey": "settings.transport.pvesh"
              }
            ]
          },
          {
            "key": "pveTokenId",
            "type": "string",
            "labelKey": "settings.tokenId.label",
            "descriptionKey": "settings.tokenId.description",
            "placeholderKey": "settings.tokenId.placeholder",
            "defaultable": false,
            "ownerOnly": true
          },
          {
            "key": "pveTokenSecret",
            "type": "secret",
            "labelKey": "settings.tokenSecret.label",
            "descriptionKey": "settings.tokenSecret.description",
            "defaultable": false,
            "ownerOnly": true
          },
          {
            "key": "pveApiHost",
            "type": "string",
            "labelKey": "settings.apiHost.label",
            "descriptionKey": "settings.apiHost.description",
            "defaultable": false
          },
          {
            "key": "pveApiPort",
            "type": "number",
            "labelKey": "settings.apiPort.label",
            "descriptionKey": "settings.apiPort.description",
            "default": 8006,
            "min": 1,
            "max": 65535,
            "defaultable": false
          },
          {
            "key": "pveCaCert",
            "type": "textarea",
            "labelKey": "settings.caCert.label",
            "descriptionKey": "settings.caCert.description",
            "placeholderKey": "settings.caCert.placeholder",
            "defaultable": false
          },
          {
            "key": "pveImportSync",
            "type": "boolean",
            "labelKey": "settings.importSync.label",
            "descriptionKey": "settings.importSync.description",
            "default": false,
            "defaultable": false,
            "ownerOnly": true,
            "group": "settings.importGroup"
          },
          {
            "key": "pveImportInterval",
            "type": "number",
            "labelKey": "settings.importInterval.label",
            "descriptionKey": "settings.importInterval.description",
            "default": 15,
            "min": 5,
            "max": 1440,
            "requires": "pveImportSync",
            "defaultable": false,
            "ownerOnly": true,
            "group": "settings.importGroup"
          },
          {
            "key": "pveImportAddNew",
            "type": "boolean",
            "labelKey": "settings.importAddNew.label",
            "descriptionKey": "settings.importAddNew.description",
            "default": false,
            "requires": "pveImportSync",
            "defaultable": false,
            "ownerOnly": true,
            "group": "settings.importGroup"
          },
          {
            "key": "pveImportDefaults",
            "type": "json",
            "hidden": true,
            "defaultable": false,
            "labelKey": "settings.importDefaults.label"
          },
          {
            "key": "pveImportState",
            "type": "json",
            "hidden": true,
            "defaultable": false,
            "labelKey": "settings.importState.label"
          },
          {
            "key": "pveSource",
            "type": "json",
            "hidden": true,
            "defaultable": false,
            "labelKey": "settings.source.label"
          }
        ]
      }
    },
    "panels": [
      {
        "id": "pve-tree",
        "titleKey": "nav.title",
        "icon": "Server"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
